# =====================================================================
#  Board GLPI — variáveis de ambiente
#  Copie para .env (NUNCA versionar) ou cadastre no painel da hospedagem.
#  Assistente guiado: ./scripts/setup-env.sh  ou  .\scripts\setup-env.ps1
# =====================================================================

# --- Conexão com o GLPI ------------------------------------------------
# URL da API REST (termina em /apirest.php). HTTPS obrigatório.
GLPI_URL=
# Configurar > Geral > API > Clientes da API > (seu cliente) > Token da aplicação
GLPI_APP_TOKEN=
# Autenticação: use UM dos dois modos. Se GLPI_USER_TOKEN estiver preenchido, ele tem prioridade.
# (A) Recomendado: Token de API do usuário de serviço (Meus ajustes > Chaves de acesso remoto > Token de API)
GLPI_USER_TOKEN=
# (B) Alternativa: login e senha do usuário de serviço (exige "Habilitar login com credenciais" na API)
GLPI_USERNAME=
GLPI_PASSWORD=
# Fuso horário em que o GLPI grava as datas (IANA). Padrão: America/Sao_Paulo
GLPI_TIMEZONE=America/Sao_Paulo

# --- Regras do board ---------------------------------------------------
# Janela (dias) para as colunas Completos e Cancelados
BOARD_DONE_DAYS=30
# ID(s) de "Tipo de solução" que significam cancelamento (Configurar > Listas suspensas > Tipos de solução). Ex.: 3 ou 3,7
BOARD_CANCELLED_SOLUTIONTYPE_IDS=
# Faixas de alerta do tempo aberto (horas): amarelo / vermelho
BOARD_AGE_WARN_HOURS=72
BOARD_AGE_CRITICAL_HOURS=168
# Cache da leitura (s) e intervalo mínimo entre ressincronizações manuais (s)
BOARD_CACHE_SECONDS=300
BOARD_REFRESH_MIN_INTERVAL_SECONDS=15

# --- Acesso ao board publicado -----------------------------------------
# Login exigido no navegador. Sem isso o board fica bloqueado (503).
BOARD_AUTH_USER=
BOARD_AUTH_PASSWORD=
# true SOMENTE se o board estiver atrás de VPN/SSO corporativo
BOARD_AUTH_DISABLED=false

# --- Banco do sistema (MySQL no Docker: docker compose up -d) -----------
# Planejamento + Gestão de Projetos. App fora do Docker: MYSQL_DB_HOST=localhost e MYSQL_DB_PORT=3316.
# Dentro do compose o host vira "mysql" automaticamente.
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3316
MYSQL_DB_NAME=board
MYSQL_DB_USER=board
# Senha do banco (gere uma aleatória). Usada também para criar o banco na 1ª subida.
MYSQL_DB_PASSWORD=
